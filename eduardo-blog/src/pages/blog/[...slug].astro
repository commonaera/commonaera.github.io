---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){const posts=await getCollection('blog',({data})=>!data.draft);return posts.map(post=>({params:{slug:post.id},props:{post}}));}
const {post}=Astro.props;
const {Content}=await render(post);
---
<Base title={`${post.data.title} — Eduardo Muñoz`} description={post.data.description}><article class="wrap article"><a class="read" href="/blog">← All posts</a><p class="eyebrow" style="margin-top:30px">{post.data.category} · {post.data.date.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}</p><h1>{post.data.title}</h1><p class="muted">{post.data.description}</p><hr style="border:0;border-top:1px solid #3c3250;margin:30px 0"/><Content/></article></Base>
