---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({data}) => !data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const categories = ['All Posts','Engineering','Projects','Travel','Reflections'];
---
<Base title="Blog — Eduardo Muñoz" description="Writing on engineering, travel, projects, and life."><div class="wrap"><section class="hero"><div class="eyebrow">THE BLOG</div><h1>Ideas, projects, and notes</h1><p class="muted">A space to document what I'm building, what I'm learning, and the ideas that keep me curious.</p></section><div class="columns"><div><div class="filters" aria-label="Filter posts">{categories.map((category,i)=><button type="button" class={i===0?'active':''} data-filter={category} aria-pressed={i===0?'true':'false'}>{category}</button>)}</div><div id="posts">{posts.map(post=><article class="post" data-category={post.data.category}>{post.data.image && <a href={`/blog/${post.id}/`}><img src={post.data.image} alt="" loading="lazy"/></a>}<div><span class="tag">{post.data.category}</span> <span class="meta">{post.data.date.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</span><h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2><p class="muted">{post.data.description}</p><a class="read" href={`/blog/${post.id}/`}>Read more →</a></div></article>)}</div><p id="no-results" class="empty" hidden>No posts in this category yet.</p></div><aside><div class="panel"><h3>About the author</h3><p class="muted">I'm Eduardo, an electrical engineer who enjoys building things, learning continuously, and exploring the world.</p><a class="read" href="/about">More about me →</a></div><div class="panel"><h3>Topics</h3><ul>{categories.slice(1).map(c=><li>{c}: {posts.filter(p=>p.data.category===c).length}</li>)}</ul></div><div class="panel"><h3>Stay in the loop</h3><p class="muted">Follow new posts using an RSS reader.</p><a class="read" href="/rss.xml">Subscribe via RSS →</a></div></aside></div></div><script>const buttons=document.querySelectorAll<HTMLButtonElement>('[data-filter]');const cards=document.querySelectorAll<HTMLElement>('[data-category]');const empty=document.querySelector<HTMLElement>('#no-results');buttons.forEach(button=>button.addEventListener('click',()=>{const selected=button.dataset.filter;let count=0;buttons.forEach(b=>{const active=b===button;b.classList.toggle('active',active);b.setAttribute('aria-pressed',String(active));});cards.forEach(card=>{const show=selected==='All Posts'||card.dataset.category===selected;card.hidden=!show;if(show)count++;});if(empty)empty.hidden=count!==0;}));</script><style>.post[hidden]{display:none}</style></Base>
